HOST=127.0.0.1
PORT=5188
FRONTEND_PORT=5189
# 须预先安装并启动 MySQL Server；npm ci 不会安装数据库。
DB_HOST=127.0.0.1
DB_PORT=3306
# 项目自动创建的数据库应用账号，不填写网页登录邮箱。
DB_USER=qingxing_app
DB_PASSWORD=replace-with-local-password
DB_NAME=campus_bike
# MySQL 管理员账号，密码是安装 MySQL 时设置的密码，不是网页演示密码。
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=replace-with-local-root-password
# 生成命令只打印随机值，须手动替换下面的占位符。
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
